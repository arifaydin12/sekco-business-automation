# --- Server ---
PORT=3000
NODE_ENV=development
# Required. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Set to 1 when running behind a reverse proxy (needed for correct client IPs in rate limiting)
TRUST_PROXY=0
# Optional: allow a different front-end origin to call the API (comma separated). Empty = same origin only.
CORS_ORIGIN=

# --- Security tuning (optional) ---
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=600

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sekco_db

# --- Tests (a separate database, must end with _test) ---
TEST_DB_NAME=sekco_test

# --- Demo data (scripts/seed.js, development only) ---
SEED_PASSWORD=Demo1234!
