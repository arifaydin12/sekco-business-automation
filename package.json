{
  "name": "sekco-business-automation",
  "version": "2.0.0",
  "description": "SEKCO - project and task management with role-based access, Kanban board and analytics. Node.js, Express and MySQL.",
  "main": "src/server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon --watch src/server src/server/index.js",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "db:seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1",
    "build:demo": "node scripts/build-demo.js",
    "serve:demo": "node scripts/serve-static.js docs 4173 /sekco-business-automation/"
  },
  "keywords": [
    "project-management",
    "task-management",
    "kanban",
    "rbac",
    "mysql",
    "nodejs",
    "express"
  ],
  "author": "Arif Enes Aydin",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1"
  }
}
